module(
    name = "rules_elixir_mix",
    version = "0.3.5",
    bazel_compatibility = [">=9.2.0"],
)

bazel_dep(
    name = "buildifier_prebuilt",
    version = "10.0.1",
    dev_dependency = True,
)

bazel_dep(
    name = "platforms",
    version = "1.1.0",
)
bazel_dep(
    name = "rules_cc",
    version = "0.2.25",
)

elixir_packages = use_extension(
    "//bzlmod:packages.bzl",
    "elixir_packages",
    dev_dependency = True,
)
use_repo(elixir_packages, "hex_pm")

register_toolchains(
    "//test:analysis_cc_arm64",
    "//test:analysis_cc_x86_64",
    "//test:otp_toolchain",
    "//test:toolchain",
    dev_dependency = True,
)
